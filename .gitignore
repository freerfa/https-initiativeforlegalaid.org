# Secrets, local state, caches — never commit
.env
__pycache__/
*.pyc
.venv/

# Live database (dev copy exists locally; prod uses a managed volume + backups)
# WAL/SHM/JOURNAL sidecars must stay untracked too — panel edits sync
# database-to-database (never through git).
site.db
site.db-wal
site.db-shm
site.db-journal
*.db-wal
*.db-shm
# Local content backups taken by scripts/sync_prod_content.py
backups/

# Uploaded images (keep the folder, ignore contents)
static/uploads/*
# but keep seed images tracked (needed on fresh deploys, e.g. Render)
!static/uploads/hero.jpg
!static/uploads/hero-alt.jpg
!static/uploads/gallery-*.jpg
!static/uploads/testimonial-*.jpg
!static/uploads/ila-logo.jpeg
!static/uploads/partner-unfpa.jpeg
!static/uploads/partner-cesyu.jpeg
!static/uploads/cesyu-ceremony.jpeg
!static/uploads/cesyu-programme.jpeg
!static/uploads/leadership-*.jpeg
!static/uploads/programme-*.jpeg
!static/uploads/testimony-*.jpeg
!static/uploads/.gitkeep

# macOS / editor noise
.DS_Store
.vscode/
# Microsoft Word lock files (created while a .docx is open)
~$*
update_seed.py
