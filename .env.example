SECRET_KEY=REPLACE-WITH--long-random-string-min-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE-WITH-a-strong-password-min-12-chars
# Set to 1 ONCE to create the first admin from the values above, then set back to 0.
ADMIN_BOOTSTRAP=0
# PORT=5001  (uncomment locally: macOS AirPlay occupies port 5000)
# FLASK_ENV=production  (set in production: refuses weak SECRET_KEY)

# --- Contact-form email notifications (optional) ---
# Render blocks outbound SMTP (ports 25/465/587), so notifications are sent over
# an email provider's HTTPS API on port 443. Resend is the default provider.
# Without RESEND_API_KEY the contact form still works: every enquiry is saved to
# the office inbox at /admin/messages, it is simply not emailed out.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=ILA Website <website@initiative4legalaid.org>
# MAIL_TO=legalaid4southsudan@gmail.com
# MAIL_API_URL=https://api.resend.com/emails
# CONTACT_RATE_LIMIT=5

# --- Git publishing from the admin panel (production) ---
# Admin public-content saves update the database first, then export only public
# content to site_data.json, commit it, and push it to the configured branch.
# Accounts, messages, credentials, and .env are never committed. Set the token
# in the Render dashboard; never store it in this file or Git.
# GIT_CONTENT_COMMIT=1
# GIT_CONTENT_BRANCH=main
# GIT_CONTENT_EMAIL=website@initiative4legalaid.org
# GITHUB_TOKEN=github_pat_replace_me
