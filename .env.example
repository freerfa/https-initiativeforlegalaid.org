SECRET_KEY=REPLACE-WITH--long-random-string-min-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE-WITH-a-strong-password-min-12-chars
# Set to 1 ONCE to create the first admin from the values above, then set back to 0.
ADMIN_BOOTSTRAP=0
# PORT=5001  (uncomment locally: macOS AirPlay occupies port 5000)
# FLASK_ENV=production  (set in production: refuses weak SECRET_KEY)
